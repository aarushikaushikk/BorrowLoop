# Borrowloop environment variables. Copy to .env and fill in real values.
# Never commit .env On Vercel, set these in the project settings instead.

# PostgreSQL connection strings (PostgreSQL > Connect > Drivers).
# Include the database name in the path, e.g. /borrowloop. Until src/lib/db.ts sets a timeout,
# add serverSelectionTimeoutMS=5000 to avoid waiting 30 seconds during an outage.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/borrowloop?sslmode=require"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/borrowloop_test?sslmode=require"


# Set to true only behind a proxy that overwrites X-Forwarded-For, such as Vercel. Rate limits
# then apply per client. Otherwise all visitors share one limit, so keep false locally.
TRUST_PROXY=false

# Cloudinary (Dashboard > API Keys). For clothing image uploads; not used by sign-in.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"